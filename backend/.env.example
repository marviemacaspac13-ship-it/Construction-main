SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after migrations 001-003 and the isolated revision checks pass.
ESTIMATE_REVISIONS_ENABLED=false

# Enable only after migration 005_private_plan_assets.sql and private-storage checks.
PLAN_ASSETS_ENABLED=false

# Explicit opt-in: plumbing images are sent to configured external image models.
# Leave false for the original local OCR-only pipeline.
PLUMBING_VISION_ENABLED=false
GEMINI_API_KEY=
PLUMBING_GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Optional further vision models, tried in this order after Gemini. No auto router.
OPENROUTER_API_KEY=
PLUMBING_OPENROUTER_MODELS=
# Set a shared random secret on multi-worker servers. Never expose to the browser.
PLUMBING_REVIEW_SECRET=
# Electrical plan images are sent to Gemini only after explicit enablement.
# Use the previously confirmed Free-tier API project; this does not change billing.
# Only these free-tier-eligible model names are accepted; at most two attempts.
# Allowed: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-2.5-flash. Default stays at two tested models.
# Local symbol detection is automatic fallback, never a frontend selector.
ELECTRICAL_VISION_ENABLED=false
ELECTRICAL_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Shared signing secret required across workers;
# when omitted, outstanding reviews expire on backend restart (four-hour limit).
ELECTRICAL_REVIEW_SECRET=

# Signs each scan result so a save stores what the scanner read. Shared across
# workers; when omitted, a backend restart between scan and save asks for a rescan.
ESTIMATE_INPUT_SECRET=
